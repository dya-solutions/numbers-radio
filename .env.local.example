# ---------------------------------------------------------------------------
# Numbers Radio - environment settings
#
# Copy this file to ".env.local" and fill in the real values.
# ".env.local" is private and is never committed to GitHub.
# On Vercel, add each of these under Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- The live audio stream (from AzuraCast / Icecast) -----------------------
# Example: https://your-station.azuracast.com/listen/numbers_radio/radio.mp3
NEXT_PUBLIC_STREAM_URL="https://example-stream.azuracast.com/listen/numbers_radio/radio.mp3"

# --- AzuraCast (used later for the live Program Guide) ---------------------
# The base address of your AzuraCast install and the station's numeric ID.
NEXT_PUBLIC_AZURACAST_BASE_URL="https://your-station.azuracast.com"
NEXT_PUBLIC_AZURACAST_STATION_ID="1"

# --- Supabase (stores feedback + prayer requests) -------------------------
# Found in your Supabase project under: Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Listen-to-the-devotion voice (ElevenLabs text-to-speech) --------------
# Server only - never put a NEXT_PUBLIC_ prefix on these.
# Key: elevenlabs.io -> your profile -> API Keys (needs the Text to Speech permission).
ELEVENLABS_API_KEY="your-elevenlabs-key"
# Voice: elevenlabs.io -> Voices -> My Voices -> three dots -> Copy voice ID.
DEVOTION_VOICE_ID="your-voice-id"

# --- Statistics (optional) ------------------------------------------------
# A private random value (16+ characters) behind the daily-changing anonymous
# visitor code. Never put NEXT_PUBLIC_ on it. If you leave it out, one is derived
# from SUPABASE_SERVICE_ROLE_KEY. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SECRET=""

# --- Admin page login (/admin) -------------------------------------------
# You choose these. They protect the page that lists all submissions.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-to-a-strong-password"
